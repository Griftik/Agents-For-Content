# ─── ФАБРИКА КОНТЕНТА @neurostrategy — пример конфигурации ───
# Скопируй в .env НА СЕРВЕРЕ и впиши реальные значения:
#   cp .env.example .env && nano .env
# Файл .env в git НЕ попадает (см. .gitignore). Секреты — только на сервере.

# Telegram-бот (Контентщик, Шаг 1). Выпусти СВЕЖИЙ токен у @BotFather.
BOT_TOKEN=REPLACE_ME

# OpenRouter — один ключ на голос + текст. Перевыпусти старый (он засветился).
OPENROUTER_KEY=REPLACE_ME

# Публичный канал — оставляй как есть, если не меняли.
CHANNEL_ID=@neurostrategy

# Твой Telegram user id (бот слушает только тебя). Узнать: @userinfobot
ALLOWED_USER_ID=REPLACE_ME

# ─── Модели (через OpenRouter) ───
POST_MODEL=anthropic/claude-3.5-sonnet
VOICE_MODEL=openai/whisper-large-v3

# ─── Хранение / синхронизация ───
# Папка «быстрой» рабочей копии на сервере.
DATA_DIR=./data
# Имя rclone-remote для Google Drive (настраивается на Шаге 2).
DRIVE_REMOTE=gdrive
# Папка на Google Drive с «ценными» данными.
DRIVE_FOLDER=Фабрика пиара
