# Один домен на всё. DOMAIN=catch.example.ru в leisure/.env включает автоматический HTTPS (Let's Encrypt) и редирект с 80.
# Без DOMAIN сайт отвечает как http://IP — только для проверки до покупки домена: установка на экран и сессии требуют HTTPS.
#
#   /api/session*, /api/health  → web  (маршруты самого Next.js: cookie сессии и его проверка живости)
#   /api/*                      → api  (FastAPI; закрытые маршруты требуют X-API-Key, его знает только сервер веба;
#                                       открыты /api/catalog, /api/events/*, в том числе .ics, и /api/health)
#   всё остальное               → web  (PWA)
{$DOMAIN::80} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }
    request_body {
        max_size 5MB
    }
    @websession path /api/session /api/session/* /api/health
    handle @websession {
        reverse_proxy web:3000
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:3000
    }
}
