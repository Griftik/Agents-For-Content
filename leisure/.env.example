# ─── Планировщик досуга — пример конфигурации ───
# cp leisure/.env.example leisure/.env && nano leisure/.env
# Реальный .env в git не попадает.

# PostgreSQL 16 (в docker-compose хост — db). Для локальной разработки хватит значения по умолчанию.
DATABASE_URL=postgresql+psycopg://leisure:leisure@localhost:5432/leisure
REDIS_URL=redis://localhost:6379/0

# Telegram-бот планировщика (отдельный от Контентщика). Выпусти у @BotFather.
LEISURE_BOT_TOKEN=REPLACE_ME

# OpenRouter — LLM-нормализация событий (второй этап, п. 7 спеки).
OPENROUTER_KEY=REPLACE_ME
NORMALIZE_MODEL=anthropic/claude-sonnet-4.5
# Сбор событий: токен Timepad API (dev.timepad.ru) и учёт robots.txt источников (1 — читать и уважать, 0 — решение владельца).
TIMEPAD_TOKEN=REPLACE_ME
COLLECTORS_RESPECT_ROBOTS=0
# Рубильник источников: имена коллекторов через запятую (afisha, mosbilet, club16tons, telegram, kudago, timepad); пусто — все включены.
COLLECTORS_DISABLED=

# Админка (SQLAdmin). Пустой пароль = админка не поднимается.
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_ME
# Ключ к API для бота/воркера/веба (заголовок X-API-Key). Обязателен: без него закрытые маршруты не работают.
# Для локальной разработки без ключа: LEISURE_DEV_OPEN_API=1 (никогда на сервере).
API_KEY=REPLACE_ME

# Mini App (приглашения друзей, docs/GROWTH.md): короткое имя приложения из @BotFather (/newapp). Задаётся ОДИН раз здесь:
# docker-compose отдаёт его api, worker и bot как MINIAPP_SHORT_NAME, а сервису web как NEXT_PUBLIC_MINIAPP_SHORT_NAME.
# Ссылка приглашения: https://t.me/<NEXT_PUBLIC_BOT_USERNAME>/<MINIAPP_SHORT_NAME>?startapp=inv_<код>.
# Пока не задано, API отдаёт url=null и web_url. Вне compose (npm run dev в webapp) то же имя — в webapp/.env.local.
# MINIAPP_SHORT_NAME=app

# Публичный адрес ВЕБА (сервис web, Next.js), а не API: на него ведут /e/<slug>, /digest, /policy в карточках бота и «Отправить другу».
# Для разработки веб слушает http://localhost:3000. Если здесь localhost или 127.0.0.1, бот не ставит URL-кнопки (Telegram их
# отклоняет) и даёт ссылки текстом, в логе при старте будет предупреждение. На сервере задай публичный https-адрес.
WEB_BASE_URL=http://localhost:3000
LEISURE_CITY=Москва
LEISURE_TZ=Europe/Moscow

# ─── Сервис web (Next.js, leisure/webapp): эти переменные читает он, а не бот и не API ───
# Имя Telegram-бота без @ — для кнопки «Отправить другу» (диплинк https://t.me/<бот>?start=e_<slug>) и входа через Telegram.
# NEXT_PUBLIC_BOT_USERNAME=your_bot
# Секрет подписи сессии веба (cookie после входа через Telegram initData): длинная случайная строка, не SECRET_KEY админки.
# Необязательно: если не задан, веб выводит секрет из LEISURE_BOT_TOKEN.
# SESSION_SECRET=
