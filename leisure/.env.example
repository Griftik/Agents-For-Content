# ─── Планировщик досуга — пример конфигурации ───
# cp leisure/.env.example leisure/.env && nano leisure/.env
# Реальный .env в git не попадает.

# PostgreSQL 16 (в docker-compose хост — db). Для локальной разработки хватит значения по умолчанию.
DATABASE_URL=postgresql+psycopg://leisure:leisure@localhost:5432/leisure
# В docker-compose пароль базы берётся отсюда (DATABASE_URL для контейнеров собирается сам); server-setup.sh генерирует его.
# POSTGRES_PASSWORD=
# Домен для Caddy (leisure/Caddyfile): задан — автоматический HTTPS и редирект с 80; пусто — http://IP только для проверки.
# DOMAIN=catch.example.ru
# Куда складывать бэкапы (backup.sh, deploy.sh; том db:/backups). По умолчанию ~/backups.
# BACKUP_DIR=
REDIS_URL=redis://localhost:6379/0

# OpenRouter — LLM-нормализация событий (второй этап, п. 7 спеки).
OPENROUTER_KEY=REPLACE_ME
NORMALIZE_MODEL=anthropic/claude-sonnet-4.5
# Сбор событий: токен Timepad API (dev.timepad.ru) и учёт robots.txt источников (1 — читать и уважать, 0 — решение владельца).
TIMEPAD_TOKEN=REPLACE_ME
COLLECTORS_RESPECT_ROBOTS=0
# Рубильник источников: имена коллекторов через запятую (afisha, mosbilet, club16tons, telegram, kudago, timepad); пусто — все включены.
COLLECTORS_DISABLED=

# Админка (SQLAdmin). Пустой пароль = админка не поднимается.
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_ME
# Ключ к API для воркера/веба (заголовок X-API-Key). Обязателен: без него закрытые маршруты не работают.
# Для локальной разработки без ключа: LEISURE_DEV_OPEN_API=1 (никогда на сервере).
API_KEY=REPLACE_ME

# Публичный адрес веб-приложения (сервис web, Next.js), а не API: на него ведут ссылки приглашений (/e/<slug>?inv=<код>, /?ref=<код>) и
# ссылки входа по почте. Установка на экран на экран работают только по HTTPS (локально — localhost). На сервере задай публичный https-адрес.
WEB_BASE_URL=http://localhost:3000
LEISURE_CITY=Москва
LEISURE_TZ=Europe/Moscow

# ─── Почта для входа на другом устройстве (magic link). Без SMTP_HOST POST /api/auth/email отвечает 503 «почта подключится позже» ───
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SSL=0

# ─── Сервис web (Next.js, leisure/webapp): эти переменные читает он, а не API ───
# Секрет подписи cookie гостевой сессии (180 дней): длинная случайная строка, не SECRET_KEY админки.
# SESSION_SECRET=
