# ─── Планировщик досуга — пример конфигурации ───
# cp leisure/.env.example leisure/.env && nano leisure/.env
# Реальный .env в git не попадает.

# PostgreSQL 16 (в docker-compose хост — db). Для локальной разработки хватит значения по умолчанию.
DATABASE_URL=postgresql+psycopg://leisure:leisure@localhost:5432/leisure
REDIS_URL=redis://localhost:6379/0

# Telegram-бот планировщика (отдельный от Контентщика). Выпусти у @BotFather.
LEISURE_BOT_TOKEN=REPLACE_ME

# OpenRouter — LLM-нормализация событий (второй этап, п. 7 спеки).
OPENROUTER_KEY=REPLACE_ME
NORMALIZE_MODEL=anthropic/claude-sonnet-4.5

# Админка (SQLAdmin). Пустой пароль = админка не поднимается.
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_ME
SECRET_KEY=REPLACE_ME
# Ключ к API для бота/воркера/веба (заголовок X-API-Key). Пустой — API открыт, только для разработки.
API_KEY=REPLACE_ME

# Публичный адрес веба (ссылки /e/<slug> в карточках и «Отправить другу»).
WEB_BASE_URL=http://localhost:8000
LEISURE_CITY=Москва
LEISURE_TZ=Europe/Moscow
