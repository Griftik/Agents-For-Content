# Копия в .env.local для локального запуска (npm run dev). Файл .env.local в git не попадает.
API_BASE_URL=http://localhost:8000
API_KEY=dev-key
LEISURE_BOT_TOKEN=REPLACE_ME
NEXT_PUBLIC_BOT_USERNAME=your_bot
# Короткое имя Mini App из BotFather (t.me/<бот>/<app>): ссылки приглашений t.me/<бот>/<app>?startapp=inv_<код>.
# Без него ссылки ведут на главное приложение бота: t.me/<бот>?startapp=inv_<код>.
NEXT_PUBLIC_MINIAPP_SHORT_NAME=app
# Необязательно:
# WEB_BASE_URL=https://досуг.example   # публичный адрес веба для ссылок «Другу»; по умолчанию берётся из заголовков запроса
# SESSION_SECRET=случайная-строка        # подпись cookie сессии; по умолчанию выводится из LEISURE_BOT_TOKEN
# Только для `npm run dev` и тестов: экраны приглашений без бэкенда (ответы из памяти, коды MOCKOK01 и др.). В production-сборке игнорируется.
# MOCK_INVITES=1
