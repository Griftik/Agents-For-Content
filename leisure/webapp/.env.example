# Копия в .env.local для локального запуска (npm run dev). Файл .env.local в git не попадает.
API_BASE_URL=http://localhost:8000
API_KEY=dev-key
LEISURE_BOT_TOKEN=REPLACE_ME
NEXT_PUBLIC_BOT_USERNAME=your_bot
# Необязательно:
# WEB_BASE_URL=https://досуг.example   # публичный адрес веба для ссылок «Другу»; по умолчанию берётся из заголовков запроса
# SESSION_SECRET=случайная-строка        # подпись cookie сессии; по умолчанию выводится из LEISURE_BOT_TOKEN
