# Копия в .env.local для локального запуска (npm run dev). Файл .env.local в git не попадает.
API_BASE_URL=http://localhost:8000
API_KEY=dev-key
# Секрет подписи cookie гостевой сессии (180 дней) и активного профиля: длинная случайная строка. Обязателен в production.
SESSION_SECRET=REPLACE_ME
# Публичный адрес приложения: ссылки приглашений /e/<slug>?inv=<код> и /r/<код>; без него берётся из заголовков запроса.
# WEB_BASE_URL=https://dosug.example
# Только для `npm run dev` и тестов: экраны без бэкенда (лента, профили, приглашения из памяти). В production-сборке игнорируется.
# MOCK_INVITES=1
# Мок почты: с MOCK_SMTP=1 «Прислать ссылку» отвечает «отправлено», без него — «почта подключится позже» (503).
# MOCK_SMTP=1
