# Бот «Заявка на разбор». Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram ------------------------------------------------------------
# Токен от @BotFather для бота BOT_NAME
BOT_TOKEN=
# username бота без @ (для ссылок вида t.me/strategy_diag_bot?start=ig)
BOT_NAME=strategy_diag_bot
# TODO(Евгений): ваш Telegram ID (узнать: написать @userinfobot). Несколько — через запятую.
ADMIN_IDS=
# Канал для специалистов (подписка не обязательна)
CHANNEL_USERNAME=neurostrategy

# --- Ссылки --------------------------------------------------------------
# TODO(Евгений): ссылка на запись на разбор (Calendly, Яндекс.Календарь, TimePad и т.п.)
BOOKING_URL=
# TODO(Евгений): ссылка на политику обработки персональных данных (152-ФЗ)
PRIVACY_URL=
# url — запись по внешней ссылке (MVP). slots — слоты в боте (полная версия).
BOOKING_MODE=url

# --- База ----------------------------------------------------------------
# По умолчанию SQLite-файл storage/bot.db. Для Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/zayavka
# DATABASE_URL=

# --- CRM -----------------------------------------------------------------
# none | google_sheets | amocrm_webhook
# На первые недели можно оставить none: все лиды всё равно в БД и в карточках админу.
CRM_SYNC=none
# Для google_sheets: JSON-ключ сервисного аккаунта и ID таблицы (из URL между /d/ и /edit).
# Таблицу нужно расшарить на email сервисного аккаунта с правом «Редактор».
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=leads
# Для amocrm_webhook: сюда уходит POST JSON лида
AMOCRM_WEBHOOK_URL=

# --- Прочее --------------------------------------------------------------
# Через сколько минут без телефона заявка уходит в работу без него
CONTACT_TIMEOUT_MIN=10
LOG_LEVEL=INFO
LOG_JSON=true
# LLM (OpenRouter) в MVP не нужен — подключается в полной версии.
# OPENROUTER_API_KEY=
# LLM_MODEL=
