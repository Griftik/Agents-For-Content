# Бот «Заявка на разбор». Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram ------------------------------------------------------------
# Токен от @BotFather для бота BOT_NAME
BOT_TOKEN=
# username бота без @ (для ссылок вида t.me/GrigorevStratagy_bot?start=ig)
BOT_NAME=GrigorevStratagy_bot
# Telegram ID админов (узнать: написать @userinfobot). Несколько — через запятую.
ADMIN_IDS=291136301
# Канал для специалистов (подписка не обязательна)
CHANNEL_USERNAME=neurostrategy

# --- Ссылки --------------------------------------------------------------
# Ссылка на запись на разбор
BOOKING_URL=https://calendly.com/egrigorev/30min
# Политика обработки персональных данных (шаблон — docs/privacy_policy_template.md).
# Открывается кнопкой «Политика ↗» рядом с галочкой согласия.
PRIVACY_URL=
# url — запись по внешней ссылке (MVP). slots — слоты в боте (полная версия).
BOOKING_MODE=url

# --- Важное из канала ---------------------------------------------------
# Добавьте бота админом в канал (право «Публикация» не нужно). Пост с этим тегом бот
# предложит разослать. Можно и без тега: перешлите пост боту.
DIGEST_TAG=#важное

# --- Платная подписка на бизнес-новости ----------------------------------
# Цена и тексты — content/subscription.yaml. Рубли: токен ЮKassa из @BotFather → Payments.
# Без токена оплата идёт в Telegram Stars (если задана price_stars).
PAYMENT_PROVIDER_TOKEN=
# Чек по 54-ФЗ через ЮKassa (у покупателя спросят email)
PAYMENT_RECEIPTS=true
# Ставка НДС для чека: 1 — без НДС (самозанятый, УСН)
PAYMENT_VAT_CODE=1
# Публичная оферта (шаблон — docs/offer_template.md)
OFFER_URL=

# --- База ----------------------------------------------------------------
# По умолчанию SQLite-файл storage/bot.db. Для Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/zayavka
# DATABASE_URL=

# --- CRM -----------------------------------------------------------------
# none | google_sheets | amocrm_webhook
# На первые недели можно оставить none: все лиды всё равно в БД и в карточках админу.
CRM_SYNC=none
# Для google_sheets: JSON-ключ сервисного аккаунта и ID таблицы (из URL между /d/ и /edit).
# Таблицу нужно расшарить на email сервисного аккаунта с правом «Редактор».
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=leads
# Для amocrm_webhook: сюда уходит POST JSON лида
AMOCRM_WEBHOOK_URL=

# --- Прочее --------------------------------------------------------------
# Через сколько минут без телефона заявка уходит в работу без него
CONTACT_TIMEOUT_MIN=10
LOG_LEVEL=INFO
LOG_JSON=true
# LLM (OpenRouter) в MVP не нужен — подключается в полной версии.
# OPENROUTER_API_KEY=
# LLM_MODEL=
